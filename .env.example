# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Never expose to the browser. Never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for patient portal links
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# WhatsApp provider (optional, integration layer works without it)
WHATSAPP_PROVIDER=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Required for the WhatsApp reminder cron job (Settings -> WhatsApp must also
# be turned on, and a doctor must set a reminder time, for anything to send).
# Generate any long random string, e.g. `openssl rand -hex 32`, and set the
# same value here and in Vercel -> Project -> Settings -> Environment Variables.
# Vercel automatically sends this as the cron job's Authorization header —
# nothing else to configure.
CRON_SECRET=

# AI assistant (optional, app works fully without it)
ANTHROPIC_API_KEY=
